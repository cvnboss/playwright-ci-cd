  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "allure:generate": "node scripts/allure-history.js && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "node scripts/allure-history.js && allure serve allure-results",
    "allure:clean": "powershell -Command \"Remove-Item -Recurse -Force allure-results, allure-report -ErrorAction SilentlyContinue\""
  },
